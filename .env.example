# ── ClickUp ─────────────────────────────────────────────────────────────────
CLICKUP_API_TOKEN=your_clickup_api_token_here
CLICKUP_LIST_ID=901614096713
CLICKUP_WEBHOOK_SECRET=                        # filled after creating the webhook in ClickUp

# ── Xero OAuth ───────────────────────────────────────────────────────────────
XERO_CLIENT_ID=your_xero_client_id_here
XERO_CLIENT_SECRET=your_xero_client_secret_here
XERO_REDIRECT_URI=https://your-app.onrender.com/xero/callback

# ── Xero invoice settings ────────────────────────────────────────────────────
XERO_ACCOUNT_CODE=200
XERO_BRANDING_THEME_ID=                        # filled after running /xero/info
XERO_WEBHOOK_KEY=                              # filled after setting up Xero webhook
XERO_TAX_TYPE=OUTPUT2                          # OUTPUT2 = GST on income (Australia)
XERO_LINE_AMOUNT_TYPE=EXCLUSIVE                # prices are ex-GST (Xero adds 10% on top)
